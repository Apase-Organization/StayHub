DB_NAME=stayhub_db
DB_USERNAME=stayhub_user
DB_PASSWORD=replace-with-a-local-password
DB_PORT=5432
APP_PORT=8080
APP_LOCAL_URL=http://localhost:8080

ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME="StayHub Administrator"

UPLOAD_USE_CLOUDINARY=false
UPLOAD_LOCAL_DIRECTORY=uploads
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=50MB
UPLOAD_MAX_IMAGES_PER_PROPERTY=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

MAIL_ENABLED=false
MAIL_SYSTEM_NAME="StayHub System"
MAIL_FROM=stayhub.system@example.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=stayhub.system@example.com
MAIL_PASSWORD=replace-with-mail-app-password

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

QUOTE_VALIDITY_SECONDS=300
# Set the merchant code and secret issued for your VNPay sandbox account before testing checkout.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_CONFIG_VERSION=sandbox-local-v1
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Browser return stays on localhost so the session can poll the authenticated status endpoint.
VNPAY_RETURN_URL=http://localhost:8080/payments/vnpay/return
# Configure the VNPay sandbox merchant IPN callback with the active Cloudflare Tunnel URL printed by dev-up.sh.
VNPAY_IPN_URL=http://localhost:8080/api/v1/payments/vnpay/ipn
